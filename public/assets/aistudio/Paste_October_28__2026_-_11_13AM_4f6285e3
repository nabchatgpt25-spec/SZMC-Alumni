import { supabase } from '../lib/supabase';
import { PostItem, PostComment, LinkMetadata } from '../types/post';

export async function fetchFeedPosts(limit = 15, offset = 0, currentUserId?: number): Promise<PostItem[]> {
  const { data: postsData, error } = await supabase
    .from('posts')
    .select(`
      id,
      author_id,
      content,
      category,
      images,
      videos,
      linked_url,
      link_metadata,
      likes_count,
      comments_count,
      is_pinned,
      is_edited,
      created_at
    `)
    .eq('is_deleted', false)
    .order('is_pinned', { ascending: false })
    .order('created_at', { ascending: false })
    .range(offset, offset + limit - 1);

  if (error || !postsData) return [];

  const postIds = postsData.map((p) => p.id);
  const authorIds = Array.from(new Set(postsData.map((p) => p.author_id)));

  const [profilesRes, commentsRes, likesRes, savedRes] = await Promise.all([
    supabase.from('alumni_profiles').select('id, full_name, avatar_url, batch_year, verification_status, profession, institution').in('id', authorIds),
    supabase.from('post_comments').select('id, post_id, user_id, content, likes_count, created_at').in('post_id', postIds).eq('is_deleted', false).order('created_at', { ascending: true }),
    currentUserId ? supabase.from('post_likes').select('post_id').eq('user_id', currentUserId).in('post_id', postIds) : Promise.resolve({ data: [] }),
    currentUserId ? supabase.from('saved_posts').select('post_id').eq('user_id', currentUserId).in('post_id', postIds) : Promise.resolve({ data: [] }),
  ]);

  const authorMap = new Map((profilesRes.data || []).map((a) => [a.id, a]));
  const myLikedPostIds = new Set((likesRes.data || []).map((l: any) => l.post_id));
  const mySavedPostIds = new Set((savedRes.data || []).map((s: any) => s.post_id));

  const commentsByPost = new Map<number, PostComment[]>();
  (commentsRes.data || []).forEach((c: any) => {
    const list = commentsByPost.get(c.post_id) || [];
    const author = authorMap.get(c.user_id) || {};
    list.push({
      id: c.id,
      postId: c.post_id,
      userId: c.user_id,
      fullName: author.full_name || 'Alumnus',
      avatarUrl: author.avatar_url || '/ndc-logo.png',
      content: c.content,
      likesCount: c.likes_count || 0,
      likedByMe: false,
      createdAt: c.created_at,
    });
    commentsByPost.set(c.post_id, list);
  });

  return postsData.map((row: any) => {
    const author = authorMap.get(row.author_id) || {};
    return {
      id: row.id,
      userId: row.author_id,
      fullName: author.full_name || 'Alumnus',
      avatarUrl: author.avatar_url || '/ndc-logo.png',
      batchYear: author.batch_year,
      verified: author.verification_status === 'verified',
      profession: author.profession,
      institution: author.institution,
      content: row.content,
      category: row.category || 'General Update',
      images: row.images || [],
      videos: row.videos || [],
      linked_url: row.linked_url,
      link_metadata: row.link_metadata,
      likesCount: row.likes_count || 0,
      commentsCount: row.comments_count || 0,
      createdAt: row.created_at,
      pinned: row.is_pinned,
      isEdited: row.is_edited,
      likedByMe: myLikedPostIds.has(row.id),
      isSaved: mySavedPostIds.has(row.id),
      comments: commentsByPost.get(row.id) || [],
    };
  });
}

export async function createPost(params: {
  authorId: number;
  content: string;
  category?: string;
  images?: string[];
  videos?: string[];
  linked_url?: string;
  link_metadata?: LinkMetadata;
}): Promise<{ success: boolean; post?: PostItem; error?: string }> {
  try {
    const payload = {
      author_id: params.authorId,
      content: params.content.trim(),
      category: params.category || 'General Update',
      images: params.images || [],
      videos: params.videos || [],
      linked_url: params.linked_url || null,
      link_metadata: params.link_metadata || null,
    };

    const { data, error } = await supabase.from('posts').insert(payload).select().single();
    if (error) return { success: false, error: error.message };

    return {
      success: true,
      post: {
        id: data.id,
        userId: params.authorId,
        fullName: 'You',
        avatarUrl: '/ndc-logo.png',
        content: data.content,
        category: data.category,
        images: data.images,
        videos: data.videos,
        linked_url: data.linked_url,
        link_metadata: data.link_metadata,
        likesCount: 0,
        commentsCount: 0,
        createdAt: new Date().toISOString(),
        likedByMe: false,
        comments: [],
      },
    };
  } catch (err: any) {
    return { success: false, error: err.message };
  }
}

export async function togglePostLike(postId: number, userId: number): Promise<boolean> {
  const { data: existing } = await supabase
    .from('post_likes')
    .select('id')
    .eq('post_id', postId)
    .eq('user_id', userId)
    .maybeSingle();

  if (existing) {
    await supabase.from('post_likes').delete().eq('id', existing.id);
    return false;
  } else {
    await supabase.from('post_likes').insert({ post_id: postId, user_id: userId });
    return true;
  }
}

export async function addComment(postId: number, userId: number, content: string): Promise<boolean> {
  const { error } = await supabase.from('post_comments').insert({
    post_id: postId,
    user_id: userId,
    content: content.trim(),
  });
  return !error;
}

export async function toggleSavePost(postId: number, userId: number): Promise<boolean> {
  const { data: existing } = await supabase
    .from('saved_posts')
    .select('id')
    .eq('post_id', postId)
    .eq('user_id', userId)
    .maybeSingle();

  if (existing) {
    await supabase.from('saved_posts').delete().eq('id', existing.id);
    return false;
  } else {
    await supabase.from('saved_posts').insert({ post_id: postId, user_id: userId });
    return true;
  }
}
