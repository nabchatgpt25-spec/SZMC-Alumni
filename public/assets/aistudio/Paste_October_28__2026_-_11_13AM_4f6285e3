import React, { useState } from 'react';
import {
  Heart,
  MessageCircle,
  Share2,
  Bookmark,
  Send,
  Pin,
  CheckCircle2,
} from 'lucide-react';
import { PostItem } from '../types/post';
import { togglePostLike, addComment, toggleSavePost } from '../services/postService';
import { LinkPreview } from './LinkPreview';

interface PostCardProps {
  post: PostItem;
  currentUserId?: number;
}

export const PostCard: React.FC<PostCardProps> = ({ post, currentUserId }) => {
  const [liked, setLiked] = useState(post.likedByMe ?? false);
  const [likesCount, setLikesCount] = useState(post.likesCount);
  const [saved, setSaved] = useState(post.isSaved ?? false);
  const [showComments, setShowComments] = useState(false);
  const [comments, setComments] = useState(post.comments || []);
  const [commentText, setCommentText] = useState('');
  const [submittingComment, setSubmittingComment] = useState(false);

  const handleLike = async () => {
    if (!currentUserId) return;
    const nextState = !liked;
    setLiked(nextState);
    setLikesCount((prev) => (nextState ? prev + 1 : Math.max(0, prev - 1)));
    await togglePostLike(post.id, currentUserId);
  };

  const handleSave = async () => {
    if (!currentUserId) return;
    setSaved(!saved);
    await toggleSavePost(post.id, currentUserId);
  };

  const handleAddComment = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!commentText.trim() || !currentUserId) return;

    setSubmittingComment(true);
    const ok = await addComment(post.id, currentUserId, commentText.trim());
    if (ok) {
      setComments((prev) => [
        ...prev,
        {
          id: Date.now(),
          postId: post.id,
          userId: currentUserId,
          fullName: 'You',
          avatarUrl: '/ndc-logo.png',
          content: commentText.trim(),
          likesCount: 0,
          likedByMe: false,
          createdAt: 'Just now',
        },
      ]);
      setCommentText('');
    }
    setSubmittingComment(false);
  };

  return (
    <div className="w-full bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-xs mb-4">
      {/* Pinned header badge */}
      {post.pinned && (
        <div className="px-4 py-1.5 bg-amber-50 dark:bg-amber-950/40 border-b border-amber-200 dark:border-amber-800 text-[11px] font-bold text-amber-700 dark:text-amber-400 flex items-center gap-1.5">
          <Pin className="w-3.5 h-3.5" />
          <span>Pinned Announcement</span>
        </div>
      )}

      {/* Author Header */}
      <div className="p-4 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <img
            src={post.avatarUrl || '/ndc-logo.png'}
            alt={post.fullName}
            className="w-10 h-10 rounded-full object-cover border border-slate-200 dark:border-slate-700"
          />
          <div>
            <div className="flex items-center gap-1.5">
              <span className="font-bold text-sm text-slate-900 dark:text-white">{post.fullName}</span>
              {post.verified && <CheckCircle2 className="w-4 h-4 text-blue-500 fill-blue-500 text-white" />}
              {post.batchYear && (
                <span className="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                  Batch '{post.batchYear}
                </span>
              )}
            </div>
            <div className="text-xs text-slate-400">
              {post.profession ? `${post.profession} · ` : ''}
              {new Date(post.createdAt).toLocaleDateString()}
            </div>
          </div>
        </div>

        <span className="px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400">
          {post.category}
        </span>
      </div>

      {/* Post Text */}
      <div className="px-4 pb-2 text-sm text-slate-800 dark:text-slate-200 whitespace-pre-line leading-relaxed">
        {post.content}
      </div>

      {/* Embedded Link / YouTube / Facebook Preview */}
      {post.linked_url && (
        <div className="px-4">
          <LinkPreview url={post.linked_url} data={post.link_metadata} />
        </div>
      )}

      {/* Multi-Image Gallery */}
      {post.images && post.images.length > 0 && (
        <div className={`mt-2 grid gap-1 px-4 ${post.images.length === 1 ? 'grid-cols-1' : 'grid-cols-2'}`}>
          {post.images.map((img, i) => (
            <img
              key={i}
              src={img}
              alt="attachment"
              className="w-full max-h-96 object-cover rounded-2xl border border-slate-100 dark:border-slate-800"
            />
          ))}
        </div>
      )}

      {/* Action Bar (Like, Comment, Save, Share) */}
      <div className="px-4 py-3 mt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-semibold text-slate-500 dark:text-slate-400">
        <div className="flex items-center gap-4">
          {/* Like Button */}
          <button
            onClick={handleLike}
            className={`flex items-center gap-1.5 transition-colors cursor-pointer ${
              liked ? 'text-rose-500 font-bold' : 'hover:text-rose-500'
            }`}
          >
            <Heart className={`w-4 h-4 ${liked ? 'fill-rose-500' : ''}`} />
            <span>{likesCount}</span>
          </button>

          {/* Comment Toggle */}
          <button
            onClick={() => setShowComments(!showComments)}
            className="flex items-center gap-1.5 hover:text-blue-500 transition-colors cursor-pointer"
          >
            <MessageCircle className="w-4 h-4" />
            <span>{comments.length}</span>
          </button>
        </div>

        <div className="flex items-center gap-3">
          <button
            onClick={handleSave}
            className={`cursor-pointer hover:text-blue-500 transition-colors ${
              saved ? 'text-blue-600 dark:text-blue-400' : ''
            }`}
          >
            <Bookmark className={`w-4 h-4 ${saved ? 'fill-current' : ''}`} />
          </button>
          <button
            onClick={() => navigator.clipboard?.writeText(window.location.href)}
            className="cursor-pointer hover:text-blue-500 transition-colors"
          >
            <Share2 className="w-4 h-4" />
          </button>
        </div>
      </div>

      {/* Comment Drawer */}
      {showComments && (
        <div className="bg-slate-50/70 dark:bg-slate-900/40 p-4 border-t border-slate-100 dark:border-slate-800 space-y-3">
          {comments.map((c) => (
            <div key={c.id} className="flex gap-2.5 items-start text-xs">
              <img src={c.avatarUrl} alt={c.fullName} className="w-7 h-7 rounded-full object-cover" />
              <div className="bg-white dark:bg-slate-800 p-2.5 rounded-2xl border border-slate-200 dark:border-slate-700 max-w-sm">
                <span className="font-bold text-slate-900 dark:text-slate-100 mr-1.5">{c.fullName}</span>
                <span className="text-slate-700 dark:text-slate-300">{c.content}</span>
              </div>
            </div>
          ))}

          {/* Add comment input */}
          <form onSubmit={handleAddComment} className="flex gap-2 pt-2">
            <input
              type="text"
              value={commentText}
              onChange={(e) => setCommentText(e.target.value)}
              placeholder="Write a comment..."
              className="flex-1 px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-blue-500"
            />
            <button
              type="submit"
              disabled={submittingComment || !commentText.trim()}
              className="px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold disabled:opacity-50 flex items-center cursor-pointer"
            >
              <Send className="w-3.5 h-3.5" />
            </button>
          </form>
        </div>
      )}
    </div>
  );
};