Tsx
import React from 'react';
import { AdminHubView } from './components/AdminHubView';
import { useAuth } from './context/AuthContext';

export const AdminPage: React.FC = () => {
  const { currentUser, isLoggedIn } = useAuth();

  // Guard: Only admins or moderators can enter
  const hasAccess = isLoggedIn && (currentUser.role === 'admin' || currentUser.role === 'moderator');

  if (!hasAccess) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-slate-900 text-white p-4">
        <div className="text-center max-w-sm">
          <div className="w-12 h-12 bg-rose-500/20 text-rose-500 rounded-full flex items-center justify-center mx-auto mb-3">
            <Lock className="w-6 h-6" />
          </div>
          <h2 className="text-xl font-bold">Access Restricted</h2>
          <p className="text-xs text-slate-400 mt-1">
            This area requires administrative privileges.
          </p>
        </div>
      </div>
    );
  }

  return (
    <AdminHubView
      currentUser={currentUser}
      onNavigate={(route) => {
        window.location.hash = route;
      }}
      onViewProfile={(userId) => {
        window.location.hash = `profile?id=${userId}`;
      }}
    />
  );
};