      {/* MODE 1: BROWSE JOBS */}
      {activeMode === 'browse' && (
        <div className="space-y-5">
          {/* Filter chips: সব | চাকরি | ইন্টার্নশিপ | রেফারেল */}
          <div className="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
            {CAREER_FILTER_TYPES.map((chip) => {
