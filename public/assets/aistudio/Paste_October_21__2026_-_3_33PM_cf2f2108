} from 'lucide-react';
import {
  BloodAlertPreference,
  BloodDonorAvailability,
  BloodDonorProfile,
  BloodGroup,
  BLOOD_GROUPS_LIST,
} from '../types/blood';
import {
  DONATION_AREAS_LIST,
  getDonorProfileByUserId,
  registerOrUpdateBloodDonor,
} from '../utils/bloodDonationService';
import { getDonorIntervalInfo } from '../utils/bloodMatching';

interface BloodDonorRegistrationProps {
  isOpen: boolean;
  onClose: () => void;
  currentUser: {
    id: number;
    fullName: string;
    avatarUrl: string;
    batchYear: number;
    profession?: string;
    institution?: string;
    phone?: string;
    whatsapp?: string;
    email?: string;
    city?: string;
  };
  onSuccess: (profile: BloodDonorProfile) => void;
}

export const BloodDonorRegistration: React.FC<BloodDonorRegistrationProps> = ({
  isOpen,
  onClose,
  currentUser,
  onSuccess,
}) => {
  const existing = getDonorProfileByUserId(currentUser.id);

  const [bloodGroup, setBloodGroup] = useState<BloodGroup>(existing?.bloodGroup || 'O+');
  const [preferredArea, setPreferredArea] = useState(existing?.preferredArea || DONATION_AREAS_LIST[0]);
  const [city, setCity] = useState(existing?.city || currentUser.city || 'Dhaka');
  const [lastDonationDate, setLastDonationDate] = useState(existing?.lastDonationDate || '');
  const [availability, setAvailability] = useState<BloodDonorAvailability>(
    existing?.availability || 'available'
  );
  const [alertPreference, setAlertPreference] = useState<BloodAlertPreference>(
    existing?.emergencyAlertPreference || 'all_urgent'
  );
  const [phone, setPhone] = useState(existing?.phone || currentUser.phone || '');
  const [whatsapp, setWhatsapp] = useState(existing?.whatsapp || currentUser.whatsapp || '');

  if (!isOpen) return null;

  const intervalInfo = getDonorIntervalInfo(lastDonationDate);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();

    const profile: BloodDonorProfile = {
      userId: currentUser.id,
      fullName: currentUser.fullName,
      avatarUrl: currentUser.avatarUrl,
      batchYear: currentUser.batchYear,
      profession: currentUser.profession,
      institution: currentUser.institution,
      phone,
      whatsapp: whatsapp || phone,
      email: currentUser.email,
      bloodGroup,
      isRegisteredDonor: true,
      availability: !intervalInfo.meetsStandardInterval ? 'on_cooldown' : availability,
      preferredArea,
      city,
      lastDonationDate: lastDonationDate || undefined,
      emergencyAlertPreference: alertPreference,
      donationHistory: existing?.donationHistory || [],
      updatedAt: new Date().toISOString(),
    };

    const saved = registerOrUpdateBloodDonor(profile);
    onSuccess(saved);
    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fade-in">
      <div className="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl w-full max-w-lg max-h-[90vh] overflow-y-auto shadow-2xl">
        <div className="sticky top-0 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between z-10">
          <div className="flex items-center gap-2 text-rose-600 dark:text-rose-500">
            <Heart className="w-5 h-5 fill-rose-600 dark:fill-rose-500" />
            <h2 className="text-lg font-black text-slate-900 dark:text-white">
              {existing ? 'Update Donor Profile' : 'Enroll as Blood Donor'}
            </h2>
          </div>
          <button
            onClick={onClose}
            className="p-1.5 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        <form onSubmit={handleSubmit} className="p-6 space-y-4">
          {/* Blood Group */}
          <div>
            <label className="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-2 uppercase">
              Select Your Blood Group *
            </label>
            <div className="grid grid-cols-4 gap-2">
              {BLOOD_GROUPS_LIST.map((bg) => (
                <button
                  type="button"
                  key={bg}
                  onClick={() => setBloodGroup(bg)}
                  className={`py-2 rounded-xl text-sm font-black transition-all ${
                    bloodGroup === bg
                      ? 'bg-rose-600 text-white shadow-md shadow-rose-600/30'
