import React, { useState, useEffect, useMemo } from 'react';
import {
  Heart,
  Plus,
  Search,
  Phone,
  MessageSquare,
  Hospital,
  MapPin,
  Calendar,
  AlertCircle,
  Users,
  ShieldCheck,
  CheckCircle2,
  Clock,
  Share2,
} from 'lucide-react';
import {
  BloodEmergencyRequest,
  BloodDonorProfile,
  BloodGroup,
  BLOOD_GROUPS_LIST,
} from '../types/blood';
import {
  loadBloodDonors,
  loadBloodRequests,
  respondToBloodRequest,
  getDonorProfileByUserId,
} from '../utils/bloodDonationService';
import {
  getBloodGroupOverviewStats,
  getDonorIntervalInfo,
} from '../utils/bloodMatching';
import { BloodRequestModal } from './BloodRequestModal';
import { BloodDonorRegistration } from './BloodDonorRegistration';

interface BloodNetworkViewProps {
  currentUser: {
    id: number;
    fullName: string;
    avatarUrl: string;
    batchYear: number;
    phone?: string;
    city?: string;
  };
}

export const BloodNetworkView: React.FC<BloodNetworkViewProps> = ({ currentUser }) => {
  const [requests, setRequests] = useState<BloodEmergencyRequest[]>(() => loadBloodRequests());
  const [donors, setDonors] = useState<BloodDonorProfile[]>(() => loadBloodDonors());

  const [selectedGroup, setSelectedGroup] = useState<string>('All');
  const [searchQuery, setSearchQuery] = useState('');
  const [availableOnly, setAvailableOnly] = useState(false);

  const [isRequestModalOpen, setIsRequestModalOpen] = useState(false);
  const [isRegisterModalOpen, setIsRegisterModalOpen] = useState(false);
  const [toastMessage, setToastMessage] = useState<string | null>(null);

  useEffect(() => {
    const handleReqChange = (e: any) => setRequests(e.detail || loadBloodRequests());
    const handleDonorChange = (e: any) => setDonors(e.detail || loadBloodDonors());

    window.addEventListener('blood_requests_changed', handleReqChange);
    window.addEventListener('blood_donors_changed', handleDonorChange);

    return () => {
      window.removeEventListener('blood_requests_changed', handleReqChange);
      window.removeEventListener('blood_donors_changed', handleDonorChange);
    };
  }, []);

  const stats = useMemo(() => getBloodGroupOverviewStats(donors, requests), [donors, requests]);

  const activeEmergencyRequests = useMemo(() => {
    return requests.filter((r) => r.status === 'Active' || r.status === 'Donor Found');
  }, [requests]);

  const filteredDonors = useMemo(() => {
    return donors.filter((d) => {
      if (selectedGroup !== 'All' && d.bloodGroup !== selectedGroup) return false;
      if (availableOnly && d.availability !== 'available') return false;
      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase();
        const matchName = d.fullName.toLowerCase().includes(q);
        const matchArea = d.preferredArea.toLowerCase().includes(q) || d.city.toLowerCase().includes(q);
        const matchBatch = d.batchYear.toString().includes(q);
        if (!matchName && !matchArea && !matchBatch) return false;
      }
      return true;
    });
  }, [donors, selectedGroup, availableOnly, searchQuery]);

  const showToast = (msg: string) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 3500);
  };

  const handleRespondAsDonor = (req: BloodEmergencyRequest) => {
    const myDonorProfile = getDonorProfileByUserId(currentUser.id);
    if (!myDonorProfile) {
      setIsRegisterModalOpen(true);
      return;
    }

    const success = respondToBloodRequest({
      requestId: req.id,
      donorUserId: currentUser.id,
      donorName: currentUser.fullName,
      donorAvatar: currentUser.avatarUrl,
      donorBatchYear: currentUser.batchYear,
      donorBloodGroup: myDonorProfile.bloodGroup,
      donorPreferredArea: myDonorProfile.preferredArea,
      donorPhone: myDonorProfile.phone,
    });

    if (success) {
      showToast('Thank you Brother! Your offer has been recorded and the family has been alerted.');
    } else {
      showToast('You have already offered to donate for this request.');
    }
  };

  return (
    <div className="max-w-7xl mx-auto px-4 py-8 space-y-8 animate-fade-in">
      {/* Toast Notification */}
      {toastMessage && (
        <div className="fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-xl border border-slate-700 text-xs font-bold flex items-center gap-2">
          <CheckCircle2 className="w-4 h-4 text-emerald-400" />
          <span>{toastMessage}</span>
        </div>
      )}

      {/* Header Banner */}
      <div className="rounded-3xl bg-gradient-to-r from-rose-600 via-red-600 to-rose-700 text-white p-6 sm:p-10 shadow-xl relative overflow-hidden">
        <div className="relative z-10 max-w-2xl space-y-4">
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-bold uppercase tracking-widest">
            <Heart className="w-3.5 h-3.5 fill-current" />
            <span>Alumni Life-Support Network</span>
          </div>
          <h1 className="text-2xl sm:text-4xl font-black tracking-tight leading-tight">
            Notre Dame Alumni Blood Donation Hub
          </h1>
          <p className="text-rose-100 text-sm sm:text-base leading-relaxed">
            Direct peer-to-peer blood discovery across batches and hospitals. Coordinate fast, transparent transfusions for brothers and their immediate family members.
          </p>
          <div className="flex flex-wrap items-center gap-3 pt-2">
            <button
              onClick={() => setIsRequestModalOpen(true)}
              className="px-5 py-3 rounded-2xl bg-white text-rose-600 hover:bg-rose-50 text-xs sm:text-sm font-bold shadow-lg flex items-center gap-2 cursor-pointer transition-transform hover:scale-105"
            >
              <Plus className="w-4 h-4" />
              <span>Request Blood Now</span>
            </button>
            <button
              onClick={() => setIsRegisterModalOpen(true)}
              className="px-5 py-3 rounded-2xl bg-rose-800/80 hover:bg-rose-800 text-white text-xs sm:text-sm font-bold border border-white/20 flex items-center gap-2 cursor-pointer transition-all"
            >
              <Heart className="w-4 h-4" />
              <span>Enroll / Update as Donor</span>
            </button>
          </div>
        </div>
      </div>

      {/* Blood Group Matrix Cards */}
      <div className="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
        {stats.map((s) => (
          <button
            key={s.bloodGroup}
            onClick={() => setSelectedGroup(selectedGroup === s.bloodGroup ? 'All' : s.bloodGroup)}
            className={`p-4 rounded-2xl border text-center transition-all cursor-pointer ${
              selectedGroup === s.bloodGroup
                ? 'bg-rose-600 text-white border-rose-600 shadow-md ring-2 ring-rose-600/30'
                : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 hover:border-rose-400'
            }`}
          >
            <div className={`text-xl font-black ${selectedGroup === s.bloodGroup ? 'text-white' : 'text-rose-600 dark:text-rose-400'}`}>
              {s.bloodGroup}
            </div>
            <div className="text-[11px] font-bold mt-1 opacity-90">
              {s.availableDonors} Available
            </div>
            {s.unitsNeeded > 0 && (
              <div className="mt-1 text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-rose-500/20 text-rose-200">
                {s.unitsNeeded} needed
              </div>
            )}
          </button>
        ))}
      </div>

      {/* Active Emergencies Section */}
      {activeEmergencyRequests.length > 0 && (
        <div className="space-y-4">
          <div className="flex items-center gap-2">
            <span className="w-2.5 h-2.5 rounded-full bg-rose-600 animate-ping" />
            <h2 className="text-lg font-black text-slate-900 dark:text-white">
              Active Emergency Requests ({activeEmergencyRequests.length})
            </h2>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {activeEmergencyRequests.map((req) => (
              <div
                key={req.id}
                className="p-5 rounded-3xl bg-white dark:bg-slate-900 border-2 border-rose-500/40 dark:border-rose-600/30 shadow-md space-y-4"
              >
                <div className="flex items-start justify-between">
                  <div className="flex items-center gap-3">
                    <div className="w-12 h-12 rounded-2xl bg-rose-600 text-white font-black text-lg flex items-center justify-center shadow-md">
                      {req.bloodGroup}
                    </div>
                    <div>
                      <h3 className="font-bold text-slate-900 dark:text-white text-base">
                        {req.hospitalName}
                      </h3>
                      <p className="text-xs text-slate-500 dark:text-slate-400 flex items-center gap-1">
                        <MapPin className="w-3.5 h-3.5" />
                        {req.hospitalArea}, {req.city}
                      </p>
                    </div>
                  </div>
                  <span className={`px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider ${
                    req.emergencyLevel === 'critical'
                      ? 'bg-red-100 text-red-700 dark:bg-red-950/60 dark:text-red-400'
                      : 'bg-amber-100 text-amber-700 dark:bg-amber-950/60 dark:text-amber-400'
                  }`}>
                    {req.emergencyLevel}
                  </span>
                </div>

                <p className="text-xs text-slate-600 dark:text-slate-300">
                  {req.description}
                </p>

                <div className="grid grid-cols-2 gap-2 text-xs bg-slate-50 dark:bg-slate-800/50 p-3 rounded-2xl">
                  <div>
                    <span className="text-slate-400 text-[10px] uppercase font-bold block">Units Required</span>
                    <span className="font-black text-slate-900 dark:text-white">
                      {req.unitsRequired} Bag{req.unitsRequired > 1 ? 's' : ''} ({req.unitsFulfilled} filled)
                    </span>
                  </div>
                  <div>
                    <span className="text-slate-400 text-[10px] uppercase font-bold block">Requester</span>
                    <span className="font-bold text-slate-900 dark:text-white truncate block">
                      {req.requesterName} (HSC '{req.requesterBatch})
                    </span>
                  </div>
                </div>

                <div className="flex items-center justify-between gap-3 pt-1">
                  {req.contactPhone && (
                    <a
                      href={`tel:${req.contactPhone}`}
                      className="flex-1 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-900 dark:text-white text-xs font-bold flex items-center justify-center gap-1.5 transition-colors"
                    >
                      <Phone className="w-3.5 h-3.5" />
                      <span>Direct Call</span>
                    </a>
                  )}
                  <button
                    onClick={() => handleRespondAsDonor(req)}
                    className="flex-1 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold flex items-center justify-center gap-1.5 transition-colors shadow-sm"
                  >
                    <Heart className="w-3.5 h-3.5 fill-current" />
                    <span>Offer to Donate</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Donor Directory Filter & Table */}
      <div className="space-y-4">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <h2 className="text-lg font-black text-slate-900 dark:text-white">
            Registered Alumni Donors ({filteredDonors.length})
          </h2>

          <div className="flex items-center gap-2">
            <div className="relative">
              <Search className="w-4 h-4 text-slate-400 absolute left-3 top-2.5" />
              <input
                type="text"
                placeholder="Search name, area, batch..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="pl-9 pr-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs text-slate-900 dark:text-white w-48 sm:w-64"
              />
            </div>
            <button
              onClick={() => setAvailableOnly(!availableOnly)}
              className={`px-3 py-1.5 rounded-xl text-xs font-bold border transition-colors ${
                availableOnly
                  ? 'bg-emerald-600 text-white border-emerald-600'
                  : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800'
              }`}
            >
              Available Only
            </button>
          </div>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {filteredDonors.map((donor) => {
            const interval = getDonorIntervalInfo(donor.lastDonationDate);
            return (
              <div
                key={donor.userId}
                className="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-3"
              >
                <div className="flex items-start justify-between">
                  <div className="flex items-center gap-3">
                    <img
                      src={donor.avatarUrl || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop&crop=faces'}
                      alt={donor.fullName}
                      className="w-10 h-10 rounded-full object-cover border border-slate-200 dark:border-slate-700"
                    />
                    <div>
                      <h4 className="font-bold text-sm text-slate-900 dark:text-white">
                        {donor.fullName}
                      </h4>
                      <p className="text-[11px] text-slate-500">
                        Batch '{donor.batchYear} • {donor.profession || 'Alumnus'}
                      </p>
                    </div>
                  </div>
                  <span className="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 font-black text-sm flex items-center justify-center">
                    {donor.bloodGroup}
                  </span>
                </div>

                <div className="text-xs text-slate-600 dark:text-slate-400 space-y-1">
                  <div className="flex items-center gap-1.5">
                    <MapPin className="w-3.5 h-3.5 text-slate-400 shrink-0" />
                    <span className="truncate">{donor.preferredArea}</span>
                  </div>
                  <div className="flex items-center gap-1.5">
                    <Clock className="w-3.5 h-3.5 text-slate-400 shrink-0" />
                    <span>{interval.label}</span>
                  </div>
                </div>

                <div className="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                  <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${
                    donor.availability === 'available' && interval.meetsStandardInterval
                      ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400'
                      : 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400'
                  }`}>
                    <span className="w-1.5 h-1.5 rounded-full bg-current" />
                    {donor.availability === 'available' && interval.meetsStandardInterval ? 'Ready to Donate' : 'Cooldown / Rest'}
                  </span>

                  <div className="flex items-center gap-1.5">
                    {donor.phone && (
                      <a
                        href={`tel:${donor.phone}`}
                        className="p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-rose-50 text-slate-600 dark:text-slate-300 hover:text-rose-600 transition-colors"
                        title="Direct Call"
                      >
                        <Phone className="w-3.5 h-3.5" />
                      </a>
                    )}
                    {donor.whatsapp && (
                      <a
                        href={`https://wa.me/${donor.whatsapp.replace(/[^0-9]/g, '')}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-emerald-50 text-slate-600 dark:text-slate-300 hover:text-emerald-600 transition-colors"
                        title="WhatsApp Message"
                      >
                        <MessageSquare className="w-3.5 h-3.5" />
                      </a>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {/* Modals */}
      <BloodRequestModal
        isOpen={isRequestModalOpen}
        onClose={() => setIsRequestModalOpen(false)}
        currentUser={currentUser}
        onSuccess={() => showToast('Emergency request broadcast live to alumni network!')}
      />

      <BloodDonorRegistration
        isOpen={isRegisterModalOpen}
        onClose={() => setIsRegisterModalOpen(false)}
        currentUser={currentUser}
        onSuccess={() => showToast('Donor profile updated successfully!')}
      />
    </div>
  );
};